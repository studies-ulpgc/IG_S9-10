precision lowp float;uniform vec2 u_resolution;uniform float u_time;float h(vec2 p){return fract(sin(dot(p,vec2(1.1,311.7)))*.5);}float n(vec2 p){vec2 i=floor(p),f=fract(p),u=f*f*(3.-2.*f),o=vec2(1,0);return mix(mix(h(i),h(i+o),u.x),mix(h(i+o.yx),h(i+1.),u.x),u.y);}float f(vec2 p){float v=0.,a=.5;for(int i=0;i<4;i++)v+=a*n(p),p*=2.,a*=.5;return v;}void main(){vec2 u=gl_FragCoord.xy/u_resolution.y,q=u*vec2(4,3)-vec2(0,u_time*1.8);float c=clamp(f(q+f(q))-u.y,0.,1.);gl_FragColor=vec4(2.*c,c*c,c*c*c*c,1);}