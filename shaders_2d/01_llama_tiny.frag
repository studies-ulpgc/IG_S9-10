precision mediump float;uniform vec2 u_resolution;uniform float u_time;void main(){vec2 p=(gl_FragCoord.xy*2.-u_resolution)/u_resolution.y;p.y+=.3;float y=p.y,h=clamp(y+.6,0.,1.5);p.x+=sin(y*3.5-u_time*3.2)*.14*h;float f=exp(-length(vec2(p.x/mix(.3,.02,clamp(y+.3,0.,1.)),y-.1))*2.2),b=sin(u_time*.8)*.5+.5,z=smoothstep(b*1.6-.2,b*1.6-.8,y),m=exp(-abs(p.x+sin(y*5.-u_time*2.)*.15*h)*5.)*smoothstep(.1,.8,y)*(1.-f);gl_FragColor=vec4(mix(vec3(2,1,.25)*vec3(f,f*f,f*f*f),vec3(.2,1.,2)*f,z)+vec3(.18,.2,.24)*m,1);}