precision lowp float;uniform vec2 u_resolution,u_mouse;uniform float u_time;void main(){vec2 p=(gl_FragCoord.xy*2.-u_resolution)/u_resolution.y;float t=u_time*1.,a=(sin(t)-.1*sin(3.*t))*.4;p*=mat2(cos(a),-sin(a),sin(a),cos(a));p.y+=.3;float d=length(p-vec2(0,clamp(p.y,0.,1.1))),g=length(p-vec2(0,clamp(p.y,-.3,0.)));vec3 c=mix(vec3(.1,.5,1),vec3(1,.1,.1),u_mouse.y/u_resolution.y);gl_FragColor=vec4(mix(c*(exp(-d*5.)*.4+exp(-d*9.)*1.)+smoothstep(.02,.008,d),vec3(.2+.4*step(.4,fract(p.y*9.))),step(g,.03)),1);}